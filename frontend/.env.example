# Deployment writes frontend/.env from Terraform outputs.
# For local development, copy this file to .env and supply an existing deployment.
# Vite proxies local /api requests to this URL.
VITE_API_URL=https://your-cloudfront-id.cloudfront.net/api
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
