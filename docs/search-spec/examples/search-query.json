{
  "size": 100,
  "timeout": "350ms",
  "track_total_hits": false,
  "_source": [
    "catalog_id",
    "product_id",
    "source_revision",
    "matching_hash"
  ],
  "query": {
    "bool": {
      "filter": [
        { "term": { "catalog_id": "example-catalog" } },
        { "term": { "category_id": "Serum" } },
        { "term": { "schema_version": "2.0" } },
        { "term": { "taxonomy_version": "example-v1" } },
        { "term": { "active": true } },
        { "term": { "is_deleted": false } },
        { "term": { "ingredient_ids": "ingredient-a" } },
        { "term": { "ingredient_ids": "ingredient-d" } },
        { "term": { "ingredient_list_complete": true } },
        { "term": { "ingredient_resolution_complete": true } },
        { "term": { "availability": "available" } },
        { "term": { "market_ids": "FR" } },
        { "term": { "currency": "EUR" } },
        { "range": { "price_minor": { "gte": 0, "lte": 3000 } } }
      ],
      "must_not": [
        { "terms": { "ingredient_ids": ["ingredient-x"] } }
      ],
      "should": [
        {
          "constant_score": {
            "filter": { "term": { "ingredient_ids": "ingredient-a" } },
            "boost": 1
          }
        },
        {
          "constant_score": {
            "filter": { "term": { "ingredient_ids": "ingredient-b" } },
            "boost": 1
          }
        },
        {
          "constant_score": {
            "filter": { "term": { "ingredient_ids": "ingredient-c" } },
            "boost": 1
          }
        }
      ],
      "minimum_should_match": 1
    }
  },
  "sort": [
    { "_score": "desc" },
    { "product_id": "asc" }
  ]
}
